# Database Configuration
# Local:    postgresql://usuario:password@localhost:5432/sistek_db
# Supabase: postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:port/database_name

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Configuration
# OBLIGATORIO. El servidor no arranca si falta, es un valor de ejemplo o mide menos de 32 caracteres.
# Genéralo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Seguridad — orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seguridad — dominios de correo permitidos para registrarse (separados por coma).
# Vacío = cualquier dominio válido y no desechable.
# Ejemplo institucional: ALLOWED_EMAIL_DOMAINS=duocuc.cl,profesor.duoc.cl
ALLOWED_EMAIL_DOMAINS=

# Email Configuration (para recuperación de contraseña)
# Gmail: host=smtp.gmail.com, port=587, use App Password si tienes 2FA
# Outlook: host=smtp.office365.com, port=587
# Mailtrap (testing): host=smtp.mailtrap.io, port=2525
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=tu-app-password
EMAIL_FROM=Sistek <tu-correo@gmail.com>

# URL del frontend (para los enlaces en los correos)
FRONTEND_URL=http://localhost:5173
